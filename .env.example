# Copy to .env.dev (local development) and fill in. Git-ignored: never commit
# a filled-in copy. Passed to the app with --dart-define-from-file.
#
# Only PUBLIC values go here (the app ships with them). Never put the Supabase
# service-role key, database password or any access token in this file.
#
# There is deliberately no .env.prod on any developer machine. Production
# values live in the GitHub "production" environment and are written into a
# temporary env file by .github/workflows/release.yml.

# "dev" shows the orange DEV ribbon in the app; "prod" shows nothing.
APP_ENV=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
POWERSYNC_URL=
SENTRY_DSN=

# Where the app looks for latest.json to offer updates (see docs/ops.md).
# Leave blank in dev: the check is off.
UPDATE_MANIFEST_URL=
